# Скопируй в .env и заполни значения (секреты не коммить).

TELEGRAM_BOT_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Локальный Ollama (на том же хосте, что и бот, по умолчанию):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=60

MORNING_CHECKIN_TIME=09:00
EVENING_CHECKIN_TIME=21:00

# Имена свойств в базе Notion (если отличаются от дефолтов):
NOTION_TITLE_PROP=Name
NOTION_GROUP_PROP=Group
NOTION_STATUS_PROP=Status
NOTION_COMPLETED_PROP=Completed
NOTION_PRIORITY_PROP=Priority
NOTION_DUE_PROP=Due
DEFAULT_GROUP=Inbox
